---
import type { BilingualText } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";
import { localized } from "../../i18n/utils";
import type { TechPlatform } from "../../data/tech-resources";

interface Props {
  platform: TechPlatform;
  lang: Locale;
}

const { platform, lang } = Astro.props;
---

<div class="bg-bg-card border border-border rounded-lg p-6 card-lift">
  <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
    <div class="w-5 h-5 bg-accent/40 rounded-sm"></div>
  </div>
  <h3 class="text-lg font-semibold tracking-wide mb-2">{localized(platform.title, lang)}</h3>
  <p class="text-text-secondary text-sm leading-relaxed">{localized(platform.description, lang)}</p>
</div>