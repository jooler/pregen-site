---
import type { BilingualText } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";
import { localized } from "../../i18n/utils";
import type { Protocol } from "../../data/tech-resources";

interface Props {
  protocol: Protocol;
  lang: Locale;
}

const { protocol, lang } = Astro.props;
---

<div class="bg-bg-card border border-border rounded-lg p-5 card-lift flex items-start gap-4">
  <div class="flex-shrink-0 w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center">
    <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
  </div>
  <div class="flex-1">
    <h4 class="text-base font-semibold tracking-wide mb-1">{localized(protocol.title, lang)}</h4>
    <p class="text-text-secondary text-sm leading-relaxed mb-3">{localized(protocol.description, lang)}</p>
    <a
      href={protocol.downloadUrl}
      class="inline-flex items-center gap-1 text-accent text-sm hover:underline"
    >
      {lang === "en" ? "Download" : "下载"} {protocol.fileType}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
    </a>
  </div>
</div>