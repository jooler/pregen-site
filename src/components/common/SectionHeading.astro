---
interface Props {
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}

const { title, subtitle, align = "center" } = Astro.props;
---

<div class={`mb-12 ${align === "center" ? "text-center" : "text-left"}`}>
  <h2 class="text-2xl md:text-3xl font-semibold tracking-wide">{title}</h2>
  {subtitle && <p class="mt-4 text-text-secondary text-lg">{subtitle}</p>}
</div>