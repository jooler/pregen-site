---
interface Props {
  alt: string;
  width: number;
  height: number;
  aspectRatio?: string;
  src?: string;
  className?: string;
}

const { alt, width, height, aspectRatio, src, className = "" } = Astro.props;
const ratio = aspectRatio || `${width}/${height}`;
---

{src ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class={`w-full h-auto object-cover ${className}`}
    loading="lazy"
  />
) : (
  <div
    class={`relative w-full bg-bg-card rounded overflow-hidden ${className}`}
    style={`aspect-ratio: ${ratio};`}
    role="img"
    aria-label={alt}
  >
    <!-- Subtle grid pattern placeholder -->
    <div class="absolute inset-0 hero-grid-bg opacity-50"></div>
    <!-- Center icon/text -->
    <div class="absolute inset-0 flex flex-col items-center justify-center">
      <svg class="w-8 h-8 text-accent/30 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span class="text-text-secondary/40 text-xs">{width}×{height}</span>
    </div>
  </div>
)}