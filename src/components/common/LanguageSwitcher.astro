---
import { localeLabels } from "../../i18n/config";
import { getAlternateUrl } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

interface Props {
  currentLang: Locale;
  currentPath: string;
}

const { currentLang, currentPath } = Astro.props;
const targetLang: Locale = currentLang === "en" ? "zh" : "en";
const targetUrl = getAlternateUrl(new URL(currentPath, "https://placeholder.com"), targetLang);
---

<a
  href={targetUrl}
  class="inline-flex items-center gap-1 px-3 py-1.5 rounded text-sm border border-border hover:border-accent hover:text-accent transition-colors text-text-secondary"
>
  {localeLabels[currentLang]}
</a>