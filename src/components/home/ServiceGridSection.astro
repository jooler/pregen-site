---
import SectionHeading from "../common/SectionHeading.astro";
import ScrollReveal from "../common/ScrollReveal.astro";
import PlaceholderImage from "../common/PlaceholderImage.astro";
import type { ServiceGridData } from "../../data/homepage";
import type { Locale } from "../../i18n/config";
import { localized, localizedHref } from "../../i18n/utils";

interface Props {
  data: ServiceGridData;
  lang: Locale;
}

const { data, lang } = Astro.props;
---

<section class="py-section bg-bg-card">
  <div class="container-content">
    <ScrollReveal>
      <SectionHeading title={localized(data.sectionTitle, lang)} />
    </ScrollReveal>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-spacing-card-gap">
      {data.cards.map((card, i) => (
        <ScrollReveal delay={i * 80}>
          <a
            href={localizedHref(card.href, lang)}
            class="block bg-bg-primary border border-border rounded-lg p-6 card-lift group"
          >
            {/* Icon placeholder */}
            <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
              <div class="w-5 h-5 bg-accent/40 rounded-sm"></div>
            </div>

            <h3 class="text-lg font-semibold tracking-wide mb-2 group-hover:text-accent transition-colors">
              {localized(card.title, lang)}
            </h3>

            <p class="text-text-secondary text-sm leading-relaxed">
              {localized(card.description, lang)}
            </p>

            {/* Arrow indicator */}
            <div class="mt-4 text-accent opacity-0 group-hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>