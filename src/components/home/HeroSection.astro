---
import CTAButton from "../common/CTAButton.astro";
import PlaceholderImage from "../common/PlaceholderImage.astro";
import ScrollReveal from "../common/ScrollReveal.astro";
import type { HeroData } from "../../data/homepage";
import type { Locale } from "../../i18n/config";
import { localized, localizedHref } from "../../i18n/utils";

interface Props {
  data: HeroData;
  lang: Locale;
}

const { data, lang } = Astro.props;
---

<section class="relative min-h-screen flex items-center pt-16 hero-grid-bg">
  <div class="container-content py-20 md:py-32">
    <div class="max-w-3xl">
      <ScrollReveal>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-wide leading-tight mb-6">
          {localized(data.headline, lang)}
        </h1>
      </ScrollReveal>

      <ScrollReveal delay={100}>
        <p class="text-text-secondary text-lg md:text-xl mb-10 leading-relaxed">
          {localized(data.subheadline, lang)}
        </p>
      </ScrollReveal>

      <ScrollReveal delay={200}>
        <div class="flex flex-col sm:flex-row gap-4">
          <CTAButton
            label={localized(data.ctaPrimary.label, lang)}
            href={localizedHref(data.ctaPrimary.href, lang)}
            variant="primary"
          />
          <CTAButton
            label={localized(data.ctaSecondary.label, lang)}
            href={localizedHref(data.ctaSecondary.href, lang)}
            variant="secondary"
          />
        </div>
      </ScrollReveal>
    </div>

    <!-- Hero visual placeholder -->
    <div class="mt-12 md:mt-16">
      <ScrollReveal delay={300}>
        <PlaceholderImage
          alt="Perturb-seq workflow visualization"
          width={1200}
          height={500}
          aspectRatio="12/5"
        />
      </ScrollReveal>
    </div>
  </div>
</section>