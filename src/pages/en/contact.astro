---
import PageLayout from "../../layouts/PageLayout.astro";
import ScrollReveal from "../../components/common/ScrollReveal.astro";
import CTAButton from "../../components/common/CTAButton.astro";
import { company } from "../../data/company";
import { localized, t } from "../../i18n/utils";
import { pageSEO } from "../../data/seo";

const lang = "en";
const seo = pageSEO.contact;
---

<PageLayout
  lang={lang}
  title={localized(seo.title, lang)}
  description={localized(seo.description, lang)}
  pageTitle={t("contact.title", lang)}
  pageSubtitle={t("contact.subtitle", lang)}
  schemaOrg={{ type: seo.schemaType, data: { name: t("contact.title", lang) } }}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">
    {/* Contact information */}
    <ScrollReveal>
      <div class="space-y-6">
        <div class="bg-bg-card border border-border rounded-lg p-6">
          <h3 class="text-sm font-semibold tracking-wide text-accent mb-4">Contact Information</h3>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <div>
                <p class="text-sm font-medium">{t("contact.email", lang)}</p>
                <p class="text-text-secondary text-sm">{company.email}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2H5a2 2 0 01-2-2V5z" />
              </svg>
              <div>
                <p class="text-sm font-medium">{t("contact.phone", lang)}</p>
                <p class="text-text-secondary text-sm">{company.phone}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <div>
                <p class="text-sm font-medium">{t("contact.address", lang)}</p>
                <p class="text-text-secondary text-sm">{localized(company.address, lang)}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </ScrollReveal>

    {/* Contact form placeholder */}
    <ScrollReveal delay={100}>
      <div class="bg-bg-card border border-border rounded-lg p-6">
        <h3 class="text-sm font-semibold tracking-wide text-accent mb-6">
          {t("contact.form.submit", lang)}
        </h3>
        <form class="space-y-4" action="#" method="POST">
          <div>
            <label class="block text-sm font-medium mb-1">{t("contact.form.name", lang)}</label>
            <input type="text" class="w-full bg-bg-primary border border-border rounded-lg px-4 py-2.5 text-sm text-text-primary placeholder-text-secondary/50 focus:border-accent focus:outline-none transition-colors" placeholder={lang === "en" ? "Your name" : "您的姓名"} />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">{t("contact.form.email", lang)}</label>
            <input type="email" class="w-full bg-bg-primary border border-border rounded-lg px-4 py-2.5 text-sm text-text-primary placeholder-text-secondary/50 focus:border-accent focus:outline-none transition-colors" placeholder={lang === "en" ? "Your email" : "您的邮箱"} />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">{t("contact.form.organization", lang)}</label>
            <input type="text" class="w-full bg-bg-primary border border-border rounded-lg px-4 py-2.5 text-sm text-text-primary placeholder-text-secondary/50 focus:border-accent focus:outline-none transition-colors" placeholder={lang === "en" ? "Organization" : "机构名称"} />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">{t("contact.form.message", lang)}</label>
            <textarea rows="4" class="w-full bg-bg-primary border border-border rounded-lg px-4 py-2.5 text-sm text-text-primary placeholder-text-secondary/50 focus:border-accent focus:outline-none transition-colors resize-none" placeholder={lang === "en" ? "Describe your project or inquiry" : "描述您的项目或需求"}></textarea>
          </div>
          <CTAButton label={t("contact.form.submit", lang)} href="#" variant="primary" fullWidth />
        </form>
      </div>
    </ScrollReveal>
  </div>
</PageLayout>