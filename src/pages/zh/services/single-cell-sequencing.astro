---
import PageLayout from "../../../layouts/PageLayout.astro";
import PlaceholderImage from "../../../components/common/PlaceholderImage.astro";
import ScrollReveal from "../../../components/common/ScrollReveal.astro";
import { singleCellSequencingPage } from "../../../data/services";
import { localized } from "../../../i18n/utils";
import { pageSEO } from "../../../data/seo";

const lang = "zh";
const seo = pageSEO["single-cell-sequencing"];

const services = [
  { title: "3' 基因表达", desc: "标准3'单细胞转录组检测，用于基因表达分析" },
  { title: "5' 基因表达", desc: "5'端捕获，支持免疫组库和V(D)J测序应用" },
  { title: "免疫组库 (V(D)J)", desc: "全长免疫受体测序，用于TCR和BCR谱系分析" },
  { title: "ATAC-seq", desc: "单细胞分辨率的染色质可及性检测" },
];
---

<PageLayout
  lang={lang}
  title={localized(seo.title, lang)}
  description={localized(seo.description, lang)}
  pageTitle={localized(singleCellSequencingPage.pageTitle, lang)}
  pageSubtitle={localized(singleCellSequencingPage.pageSubtitle, lang)}
  schemaOrg={{ type: seo.schemaType, data: { name: localized(singleCellSequencingPage.pageTitle, lang) } }}
>
  <div class="py-8">
    <ScrollReveal>
      <PlaceholderImage
        alt="单细胞测序流程"
        width={1200}
        height={500}
        aspectRatio="12/5"
      />
    </ScrollReveal>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
    {services.map((service, i) => (
      <ScrollReveal delay={i * 80}>
        <div class="bg-bg-card border border-border rounded-lg p-6 card-lift">
          <h3 class="text-lg font-semibold tracking-wide mb-2">{service.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{service.desc}</p>
        </div>
      </ScrollReveal>
    ))}
  </div>

  <p class="mt-6 text-text-secondary/60 text-xs">
    具体方案需技术沟通确认。
  </p>
</PageLayout>